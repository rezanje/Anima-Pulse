# =====================================================================
# Anima Pulse — environment
# Leave EVERYTHING blank to run fully local (MockRepo + dev-login).
# Fill these in to switch to real Supabase + Google SSO (production).
# =====================================================================

# --- Supabase (presence of SUPABASE_URL flips the app to cloud mode) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Workspace SSO (FR-AUTH-01) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only emails on this domain may sign in (e.g. animacompanion.com)
COMPANY_DOMAIN=

# --- Dev session signing (used in local/dev-login mode) ---
# Any random string; required for the signed dev-session cookie.
DEV_SESSION_SECRET=dev-only-change-me
